{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "starlight-openapi": ["./src/env.d.ts"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "*.ts"],
  "exclude": ["dist", "node_modules"]
}
