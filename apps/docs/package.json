{
  "name": "@vicacha-devs/docs",
  "version": "1.0.0",
  "private": true,
  "description": "Starlight documentation site and interactive OpenAPI reference for the @vicacha-devs Strapi v5 plugin suite",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "node scripts/generate-openapi.ts && node scripts/sync-readmes.ts && astro build",
    "capture:screenshots": "node scripts/capture-screenshots.ts",
    "deploy": "wrangler pages deploy dist --commit-dirty=true",
    "dev": "node scripts/generate-openapi.ts && node scripts/sync-readmes.ts && astro dev --host 127.0.0.1",
    "generate:openapi": "node scripts/generate-openapi.ts",
    "preview": "astro preview --host 127.0.0.1",
    "sync:readmes": "node scripts/sync-readmes.ts",
    "test:judges": "node scripts/adversarial-judges.ts",
    "test:ts": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.34.3",
    "@astrojs/starlight-tailwind": "^4.0.1",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/roboto-mono": "^5.2.5",
    "@tailwindcss/vite": "^4.1.4",
    "astro": "^5.7.5",
    "starlight-llms-txt": "^0.6.0",
    "starlight-openapi": "^0.17.0",
    "tailwindcss": "^4.1.4",
    "vite": "^6.3.2",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.2",
    "playwright": "^1.52.0",
    "typescript": "^5.9.3"
  }
}
