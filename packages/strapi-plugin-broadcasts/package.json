{
  "name": "@vicacha-devs/strapi-plugin-broadcasts",
  "version": "0.1.0",
  "description": "Omnichannel community broadcasts (Email newsletters, Telegram Bot & Channel/Forum topics, WhatsApp Cloud API / OpenWA / Evolution, EventHub automation rules, and double opt-in subscriber segmentation) for Strapi v5 with multi-language and multi-calendar support.",
  "keywords": [
    "broadcasts",
    "email",
    "hijri",
    "i18n",
    "multi-calendar",
    "newsletter",
    "notifications",
    "omnichannel",
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "telegram",
    "whatsapp"
  ],
  "homepage": "https://github.com/Vicacha-Devs/strapi-v5-extensions/tree/main/packages/strapi-plugin-broadcasts#readme",
  "bugs": {
    "url": "https://github.com/Vicacha-Devs/strapi-v5-extensions/issues"
  },
  "license": "MIT",
  "author": "Vicacha Devs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vicacha-Devs/strapi-v5-extensions.git",
    "directory": "packages/strapi-plugin-broadcasts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.mjs"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "source": "./shared/index.ts",
      "import": "./dist/shared/index.mjs",
      "require": "./dist/shared/index.js",
      "default": "./dist/shared/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "strapi-plugin build && node ../../scripts/ensure-esm-dist.ts",
    "test": "node --import ./tests/register-ts-resolver.ts --test tests/*.test.ts",
    "test:ts": "tsc --noEmit -p admin/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test:ts:admin": "tsc --noEmit -p admin/tsconfig.json",
    "test:ts:server": "tsc --noEmit -p server/tsconfig.json",
    "verify": "strapi-plugin verify",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link"
  },
  "dependencies": {
    "@strapi/design-system": "^2.0.0-rc.21",
    "@strapi/icons": "^2.0.0-rc.21",
    "@vicacha-devs/strapi-plugin-calendar": "workspace:*",
    "react-intl": "^6.6.8"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "6.1.1",
    "@strapi/strapi": "^5.39.0",
    "@vicacha-devs/eslint-config": "workspace:*",
    "@vicacha-devs/typescript-config": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "styled-components": "^6.1.13",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=20.16.0",
    "pnpm": ">=10.0.0"
  },
  "strapi": {
    "name": "broadcasts",
    "displayName": "Community Broadcasts",
    "description": "Omnichannel Email, Telegram & WhatsApp broadcasts, EventHub automation rules, and segmented subscriber dispatch",
    "kind": "plugin",
    "required": false
  }
}
