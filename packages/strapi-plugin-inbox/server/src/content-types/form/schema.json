{
  "kind": "collectionType",
  "collectionName": "inbox_forms",
  "info": {
    "singularName": "form",
    "pluralName": "forms",
    "displayName": "Inbox Form",
    "description": "Visual Form Builder & Service-Desk Casework definition"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "contact",
        "service_desk",
        "inquiry",
        "application",
        "volunteer",
        "custom"
      ],
      "default": "contact",
      "required": true
    },
    "fields": {
      "type": "json",
      "required": true,
      "default": []
    },
    "checklistTemplate": {
      "type": "json",
      "default": []
    },
    "settings": {
      "type": "json",
      "default": {}
    },
    "translations": {
      "type": "json",
      "default": {}
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "submissionCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    }
  }
}
