{
  "name": "@vicacha-devs/strapi-plugin-seo",
  "version": "2.0.12",
  "description": "Make your Strapi content SEO friendly.",
  "keywords": [
    "strapi",
    "strapi-v5",
    "strapi-plugin",
    "seo",
    "open-graph",
    "structured-data"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.ts",
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js",
      "require": "./dist/admin/index.cjs",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs",
      "default": "./dist/server/index.js"
    },
    "./shared": {
      "source": "./shared/index.ts",
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.cjs",
      "default": "./dist/shared/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "verify": "strapi-plugin verify",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "test:ts": "npm run test:ts:front && npm run test:ts:back",
    "test:ts:front": "tsc --noEmit -p admin/tsconfig.json",
    "test:ts:back": "tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lodash": "^4.17.21",
    "showdown": "^2.1.0"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "6.1.1",
    "@strapi/strapi": "5.59.0",
    "@types/node": "22.10.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vicacha-devs/typescript-config": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "styled-components": "^6.1.13",
    "typescript": "5.9.3",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@types/lodash": "^4.17.0",
    "@types/showdown": "^2.0.6",
    "react-intl": "^6.6.8"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0",
    "@strapi/design-system": "^2.2.0",
    "@strapi/icons": "^2.2.0",
    "react-intl": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vicacha-devs/strapi-v5-extensions.git",
    "directory": "packages/strapi-plugin-seo"
  },
  "license": "MIT",
  "strapi": {
    "name": "seo",
    "displayName": "SEO",
    "description": "Make your Strapi content SEO friendly.",
    "kind": "plugin"
  }
}
