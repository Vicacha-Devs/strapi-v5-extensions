{
  "name": "@vicacha-devs/strapi-plugin-islam",
  "version": "1.0.0",
  "description": "Comprehensive Strapi v5 Islamic Liturgical, Scriptural & Fiqh Suite: Salah/Adhan/Iqamah Astronomical Engine, Qibla Spherical Compass, Hilal Moon-Sighting & Eid/Ramadan Operations, Quran/Hadith/Dua Hub, and Zakat/Nisab/Fitrana/Fidyah/Kaffarah Calculators powered by @vicacha-devs/strapi-plugin-calendar",
  "author": "Vicacha Devs",
  "keywords": [
    "strapi",
    "strapi-v5",
    "strapi-plugin",
    "islam",
    "adhan",
    "salah",
    "iqamah",
    "qibla",
    "hijri",
    "eid",
    "ramadan",
    "quran",
    "hadith",
    "dua",
    "zakat",
    "nisab"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vicacha-devs/strapi-v5-extensions.git",
    "directory": "packages/strapi-plugin-islam"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.ts",
      "types": "./dist/admin/src/index.d.ts",
      "import": "./dist/admin/index.js",
      "require": "./dist/admin/index.cjs",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "types": "./dist/server/src/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs",
      "default": "./dist/server/index.js"
    },
    "./shared": {
      "source": "./shared/index.ts",
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.cjs",
      "default": "./dist/shared/index.js"
    }
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts": "npm run test:ts:front && npm run test:ts:back",
    "test:ts:front": "tsc --noEmit -p admin/tsconfig.json",
    "test:ts:back": "tsc --noEmit -p server/tsconfig.json",
    "test": "node --import ./tests/register-ts-resolver.mjs --test tests/*.test.ts",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@strapi/design-system": "2.2.0",
    "@strapi/icons": "2.2.0",
    "@vicacha-devs/strapi-plugin-calendar": "workspace:*",
    "react-intl": "8.1.3"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "6.1.1",
    "@strapi/strapi": "5.39.0",
    "@strapi/typescript-utils": "5.39.0",
    "@types/node": "22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vicacha-devs/eslint-config": "workspace:*",
    "@vicacha-devs/typescript-config": "workspace:*",
    "prettier": "3.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "styled-components": "6.3.11",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "peerDependencies": {
    "@strapi/sdk-plugin": "^5.0.0 || ^6.0.0",
    "@strapi/strapi": "^5.0.0",
    "@vicacha-devs/strapi-plugin-calendar": "^1.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "islam",
    "displayName": "Islam Suite (Salah, Qibla, Hijri, Quran, Hadith, Dua & Zakat)",
    "description": "Mosque Salah/Adhan/Iqamah Engine, Qibla Compass, Hilal/Eid/Ramadan Operations, Quran/Hadith/Dua Hub & Zakat/Nisab Calculators"
  },
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  }
}
