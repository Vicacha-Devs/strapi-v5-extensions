{
  "name": "@vicacha-devs/strapi-plugin-events",
  "version": "1.1.1",
  "description": "Production-grade Strapi v5 Events, RSVP Capacity, Automatic Waitlist Promotion, Attendee Check-In & iCal Plugin powered by @vicacha-devs/strapi-plugin-calendar",
  "keywords": [
    "calendar",
    "events",
    "ical",
    "plugin",
    "rrule",
    "rsvp",
    "strapi",
    "strapi-v5",
    "waitlist"
  ],
  "homepage": "https://github.com/Vicacha-Devs/strapi-v5-extensions/tree/main/packages/strapi-plugin-events#readme",
  "bugs": {
    "url": "https://github.com/Vicacha-Devs/strapi-v5-extensions/issues"
  },
  "license": "MIT",
  "author": "Vicacha Devs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vicacha-Devs/strapi-v5-extensions.git",
    "directory": "packages/strapi-plugin-events"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "source": "./shared/index.ts",
      "import": "./dist/shared/index.mjs",
      "require": "./dist/shared/index.js",
      "default": "./dist/shared/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "strapi-plugin build && node ../../scripts/ensure-dist-types.ts",
    "clean": "rm -rf dist .strapi",
    "test": "node --import ./tests/register-ts-resolver.ts --test tests/*.test.ts",
    "test:ts": "npm run test:ts:front && npm run test:ts:back",
    "test:ts:back": "tsc --noEmit -p server/tsconfig.json",
    "test:ts:front": "tsc --noEmit -p admin/tsconfig.json",
    "verify": "strapi-plugin verify",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link"
  },
  "dependencies": {
    "@strapi/design-system": "2.2.0",
    "@strapi/icons": "2.2.0",
    "react-intl": "8.1.3"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "6.1.1",
    "@strapi/strapi": "5.39.0",
    "@strapi/typescript-utils": "5.39.0",
    "@types/node": "22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vicacha-devs/eslint-config": "workspace:*",
    "@vicacha-devs/plugin-shared": "workspace:*",
    "@vicacha-devs/strapi-plugin-calendar": "workspace:*",
    "@vicacha-devs/typescript-config": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "styled-components": "6.3.11",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/sdk-plugin": "^5.0.0 || ^6.0.0",
    "@strapi/strapi": "^5.0.0",
    "@vicacha-devs/strapi-plugin-calendar": "^1.1.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=20.16.0",
    "pnpm": ">=10.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "events",
    "displayName": "Events & RSVPs",
    "description": "Manage recurring events, RSVPs, seat capacity, waitlists, and attendee check-in in Strapi v5 powered by @vicacha-devs/strapi-plugin-calendar"
  }
}
