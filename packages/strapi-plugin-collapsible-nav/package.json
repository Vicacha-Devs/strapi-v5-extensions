{
  "name": "@vicacha-devs/strapi-plugin-collapsible-nav",
  "version": "1.0.0",
  "description": "Restores Strapi v4-style collapsible/expandable left navigation sidebar in the Strapi v5 admin panel.",
  "keywords": [
    "admin",
    "collapsible",
    "left-menu",
    "navigation",
    "sidebar",
    "strapi",
    "strapi-plugin",
    "strapi-v5"
  ],
  "homepage": "https://github.com/Vicacha-Devs/strapi-v5-extensions/tree/main/packages/strapi-plugin-collapsible-nav#readme",
  "bugs": {
    "url": "https://github.com/Vicacha-Devs/strapi-v5-extensions/issues"
  },
  "license": "MIT",
  "author": "Vicacha Devs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vicacha-Devs/strapi-v5-extensions.git",
    "directory": "packages/strapi-plugin-collapsible-nav"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepublishOnly": "npm run build",
    "test": "tsx tests/navDomController.test.ts",
    "test:ts": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vicacha-devs/plugin-shared": "workspace:*",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "engines": {
    "node": ">=20.16.0",
    "pnpm": ">=10.0.0"
  },
  "strapi": {
    "name": "collapsible-nav",
    "kind": "plugin",
    "displayName": "Collapsible Nav",
    "description": "Restores Strapi v4-style collapsible/expandable left navigation sidebar."
  }
}
