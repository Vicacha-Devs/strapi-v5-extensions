{
  "kind": "collectionType",
  "collectionName": "media_feed_items",
  "info": {
    "singularName": "media-item",
    "pluralName": "media-items",
    "displayName": "Media Episode & Feed Item",
    "description": "Generic multi-language video, podcast, audio lecture, YouTube item, or live broadcast"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    },
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "transcript": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "type": {
      "type": "string",
      "default": "video",
      "required": true
    },
    "provider": {
      "type": "enumeration",
      "enum": [
        "youtube",
        "spotify",
        "apple_podcasts",
        "vimeo",
        "soundcloud",
        "direct",
        "upload"
      ],
      "default": "youtube"
    },
    "externalId": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "embedUrl": {
      "type": "string"
    },
    "speaker": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "speakerSlug": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "seriesSlug": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "publishedAtLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "imageUrl": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "audioFile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["audios"],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "transcriptFile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["files"],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "spokenLanguages": {
      "type": "json",
      "default": ["es"]
    },
    "languageTracks": {
      "type": "json",
      "default": []
    },
    "chapters": {
      "type": "json",
      "default": []
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "isLive": {
      "type": "boolean",
      "default": false
    }
  }
}
