{
  "kind": "collectionType",
  "collectionName": "notes",
  "info": {
    "singularName": "note",
    "pluralName": "notes",
    "displayName": "Notes",
    "description": "Editorial notes attached to Content Manager entity records"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "content": {
      "type": "text"
    },
    "category": {
      "type": "enumeration",
      "enum": ["general", "todo", "blocker", "idea"],
      "default": "general",
      "required": true
    },
    "isPinned": {
      "type": "boolean",
      "default": false
    },
    "entityId": {
      "type": "integer"
    },
    "entityDocumentId": {
      "type": "string",
      "maxLength": 128
    },
    "entitySlug": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "entityLocale": {
      "type": "string",
      "maxLength": 32
    },
    "createdByName": {
      "type": "string",
      "maxLength": 120
    },
    "updatedByName": {
      "type": "string",
      "maxLength": 120
    }
  }
}
