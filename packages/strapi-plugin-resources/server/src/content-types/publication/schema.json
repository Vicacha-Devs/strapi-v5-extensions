{
  "kind": "collectionType",
  "collectionName": "resources_publications",
  "info": {
    "singularName": "publication",
    "pluralName": "publications",
    "displayName": "Resource Publication",
    "description": "Localized digital library books, guides, pamphlets, and press kit assets backed by the Strapi v5 Media Library"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    },
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "summary": {
      "type": "text",
      "required": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "guide",
        "book",
        "pamphlet",
        "press_kit",
        "academic",
        "general"
      ],
      "default": "guide",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "file": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files", "images", "audios"],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "authorName": {
      "type": "string",
      "maxLength": 140,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "authorSlug": {
      "type": "string",
      "maxLength": 140,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isbnOrReference": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "pageCount": {
      "type": "integer",
      "min": 1,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "languageCode": {
      "type": "string",
      "default": "es",
      "maxLength": 10,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "publishedAtDate": {
      "type": "date",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "secondaryDateOverride": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "mediaFolderPath": {
      "type": "string",
      "maxLength": 160,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "externalDownloadUrl": {
      "type": "string",
      "maxLength": 500,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "downloadCount": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "allowPublicDownload": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
