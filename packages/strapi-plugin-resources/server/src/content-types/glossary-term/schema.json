{
  "kind": "collectionType",
  "collectionName": "resources_glossary_terms",
  "info": {
    "singularName": "glossary-term",
    "pluralName": "glossary-terms",
    "displayName": "Resource Glossary Term",
    "description": "Multilingual A-Z glossary terms with native script, transliteration, and Strapi Media Library audio pronunciation"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    },
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "term": {
      "type": "string",
      "required": true,
      "maxLength": 120,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "term",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "nativeScript": {
      "type": "string",
      "maxLength": 200,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "transliteration": {
      "type": "string",
      "maxLength": 200,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "definition": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "category": {
      "type": "enumeration",
      "enum": ["beliefs", "worship", "ethics", "history", "community", "general"],
      "default": "general",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "letterGroup": {
      "type": "string",
      "default": "A",
      "maxLength": 4,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "pronunciationAudio": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["audios"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "relatedTerms": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
