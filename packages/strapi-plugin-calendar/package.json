{
  "name": "@vicacha-devs/strapi-plugin-calendar",
  "version": "1.0.0",
  "description": "Universal Multi-Source Calendar, FullCalendar v6 Scheduler, RFC 5545/7529 Recurrence (RRULE & RSCALE), Multi-Calendar Systems (Hijri, Hebrew, Persian, etc.), and iCal (.ics) plugin for Strapi v5.",
  "author": "Vicacha Devs",
  "license": "MIT",
  "type": "commonjs",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "calendar",
    "fullcalendar",
    "scheduler",
    "rrule",
    "rscale",
    "ical",
    "ics",
    "hijri",
    "hebrew",
    "persian",
    "internationalized-date"
  ],
  "strapi": {
    "name": "calendar",
    "displayName": "Calendar & Scheduler",
    "description": "Visualize, schedule, and syndicate any Strapi v5 collection types across Month, Week, Day, Agenda, and Year views with multi-calendar & RRULE support.",
    "kind": "plugin"
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./shared": {
      "types": "./dist/server/shared/index.d.ts",
      "source": "./shared/index.ts",
      "import": "./shared/index.ts",
      "require": "./shared/index.ts",
      "default": "./shared/index.ts"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vicacha-devs/strapi-v5-extensions.git",
    "directory": "packages/strapi-plugin-calendar"
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "clean": "rm -rf dist .strapi",
    "test": "node --import ./tests/register-ts-resolver.mjs --test tests/*.test.ts",
    "test:ts": "npm run test:ts:front && npm run test:ts:back",
    "test:ts:front": "tsc -p admin/tsconfig.json --noEmit",
    "test:ts:back": "tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/multimonth": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@internationalized/date": "^3.10.0",
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "react-intl": "^6.6.8"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^5.3.0",
    "@strapi/strapi": "^5.0.0",
    "@strapi/typescript-utils": "^5.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vicacha-devs/typescript-config": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "styled-components": "^6.1.12",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  }
}
