{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "shared/**/*",
    "server/src/**/*",
    "server/src/custom.d.ts",
    "admin/src/**/*",
    "admin/src/custom.d.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
