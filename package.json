{
  "name": "@vicacha-devs/strapi-v5-extensions",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "author": "Vicacha Devs",
  "description": "Enterprise Strapi v5 Extensions & Plugins Monorepo (@vicacha-devs/strapi-plugin-calendar, @vicacha-devs/strapi-plugin-events, and companion plugins)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vicacha-devs/strapi-v5-extensions.git",
    "directory": "."
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "dashboard:dev": "pnpm --filter @vicacha-devs/dashboard develop",
    "dashboard:start": "pnpm --filter @vicacha-devs/dashboard start",
    "test": "turbo run test",
    "test:ts": "turbo run test:ts",
    "verify": "turbo run verify",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "prettier": "^3.8.1",
    "turbo": "^2.4.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
